# セッション暗号化キー（32文字以上のランダム文字列）
NUXT_SESSION_PASSWORD=

# Google OAuth（Google Cloud Console で作成。リダイレクトURI: <origin>/auth/google）
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# ログインを許可するメールドメイン
NUXT_ALLOWED_EMAIL_DOMAIN=g.ecc.u-tokyo.ac.jp

# 最初の管理者（カンマ区切り）。ログインのたびに管理者になり、画面からは変更できない。
# ほかの人の権限（一般委員・局長・会計担当・管理者）は、管理者が「ユーザー」画面で変える
NUXT_ADMIN_EMAILS=

# DB（ローカルは file:、本番は Turso の libsql://… URL とトークン）
# 添付ファイルも DB に保存する
NUXT_DATABASE_URL=file:.data/app.db
NUXT_DATABASE_AUTH_TOKEN=

# n8n 通知（Slack 転送用）。口座情報は送信されない
NUXT_N8N_WEBHOOK_URL=
NUXT_N8N_WEBHOOK_SECRET=

# ローカル開発用：Google を使わずに任意のメールでログインできる（本番では絶対に true にしない）
NUXT_PUBLIC_DEV_LOGIN=false
